---
import business from '../data/business.json';
import google from '../data/google.json';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const phone = google.phone || business.phone;
const address = google.address || [business.address.street, business.address.postalCode, business.address.city].filter(Boolean).join(', ');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  name: business.name,
  legalName: business.legalName,
  description: business.description,
  url: Astro.site.href + base.slice(1) + '/',
  ...(phone && { telephone: phone }),
  ...(business.address.city && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.street,
      postalCode: business.address.postalCode,
      addressLocality: business.address.city,
      addressCountry: 'FR',
    },
  }),
  ...(google.rating && {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: google.rating, reviewCount: google.total },
  }),
  makesOffer: business.services.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title, description: s.text },
  })),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={`${base}/`}>Verny <span>Charpente</span></a>
        <nav>
          <a href="#services">Services</a>
          <a href="#avis">Avis</a>
          <a href="#contact" class="btn small">Contact</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} {business.name} — {business.legalName}, SIREN {business.siren}</p>
        <p class="demo">Site de démonstration.</p>
      </div>
    </footer>
    <style is:global>
      :root { --ink:#2b2118; --wood:#8a5a2b; --wood-dark:#5e3b1a; --cream:#faf6ef; --zinc:#6b7782; --white:#fff; }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin:0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color:var(--ink); background:var(--cream); line-height:1.6; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      a { color: var(--wood-dark); }
      h1,h2,h3 { line-height:1.2; }
      h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0 0 1rem; }
      section { padding: 64px 0; }
      .btn { display:inline-block; background:var(--wood); color:#fff; padding:.8rem 1.4rem; border-radius:6px; text-decoration:none; font-weight:600; }
      .btn:hover { background: var(--wood-dark); }
      .btn.small { padding:.4rem .9rem; }
      .btn.ghost { background:transparent; color:#fff; border:2px solid #fff; }
      .site-header { position:sticky; top:0; z-index:10; background:var(--white); border-bottom:1px solid #eadfce; }
      .bar { display:flex; justify-content:space-between; align-items:center; height:60px; }
      .brand { font-weight:800; font-size:1.25rem; text-decoration:none; color:var(--ink); }
      .brand span { color:var(--wood); }
      nav { display:flex; gap:20px; align-items:center; }
      nav a { text-decoration:none; color:var(--ink); }
      nav a.btn { color:#fff; }
      .site-footer { background:var(--ink); color:#d8cbb8; padding:28px 0; font-size:.9rem; }
      .site-footer p { margin:.2rem 0; }
      .demo { opacity:.7; }
      @media (max-width:560px){ nav a:not(.btn){ display:none; } }
    </style>
  </body>
</html>
