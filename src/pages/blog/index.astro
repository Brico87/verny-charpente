---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Conseils — Verny Charpente" description="Conseils de Verny Charpente : charpente, couverture, zinguerie dans les Landes et au Pays Basque.">
  <main>
    <section>
      <div class="wrap">
        <h1>Conseils</h1>
        <p>Nos conseils sur la charpente, la couverture et la zinguerie.</p>
        {posts.length === 0 ? <p>Aucun article pour le moment.</p> : (
          <div class="grid">
            {posts.map((p) => <PostCard href={`/blog/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date} label={p.data.category} image={p.data.image} imageAlt={p.data.imageAlt} />)}
          </div>
        )}
      </div>
    </section>
  </main>
</Base>
<style>
  h1 { margin-top:0; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; margin-top:24px; }
</style>
