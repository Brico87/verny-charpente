---
import Base from '../layouts/Base.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import business from '../data/business.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chantiers = (await getCollection('chantiers', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base title="Verny Charpente — Charpentier, couvreur, zingueur" description={business.description.slice(0, 155) + '…'}>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>Charpente, couverture &amp; zinguerie</h1>
        <p>Des ouvrages durables et soignés, de la construction à la rénovation de votre toiture — depuis {business.address.city}, dans les Landes et au Pays Basque.</p>
        <p><a class="btn" href="#contact">Demander un devis</a> <a class="btn ghost" href="#services">Nos services</a></p>
      </div>
    </section>

    <section id="presentation">
      <div class="wrap narrow">
        <h2>Verny Charpente</h2>
        <p>{business.description}</p>
        <p><strong>Zone d’intervention :</strong> {business.areaServed.join(' et ')}.</p>
      </div>
    </section>

    <section id="services" class="alt">
      <div class="wrap">
        <h2>Nos services</h2>
        <div class="grid">
          {business.services.map((s) => (
            <article class="card"><h3>{s.title}</h3><p>{s.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    {chantiers.length > 0 && (
      <section id="realisations">
        <div class="wrap">
          <h2>Nos dernières réalisations</h2>
          <div class="grid">
            {chantiers.map((p) => (
              <PostCard href={`/realisations/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date}
                label={p.data.city} image={p.data.images[0]?.src} imageAlt={p.data.images[0]?.alt} />
            ))}
          </div>
          <p><a href={`${base}/realisations/`}>Voir toutes les réalisations →</a></p>
        </div>
      </section>
    )}

    {posts.length > 0 && (
      <section id="conseils" class="alt">
        <div class="wrap">
          <h2>Conseils</h2>
          <div class="grid">
            {posts.map((p) => <PostCard href={`/blog/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date} label={p.data.category} image={p.data.image} imageAlt={p.data.imageAlt} />)}
          </div>
          <p><a href={`${base}/blog/`}>Voir tous les conseils →</a></p>
        </div>
      </section>
    )}

    <Reviews />
    <Contact />
  </main>
</Base>
<style>
  .hero { background: linear-gradient(135deg, var(--wood-dark), #2b2118); color:#fff; padding: 110px 0; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin:0 0 .6rem; }
  .hero p { font-size:1.15rem; max-width: 620px; }
  .narrow { max-width: 760px; }
  .alt { background:#f1e8da; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; }
  .card { background:#fff; border-radius:10px; padding:20px; border-left:4px solid var(--wood); }
  .card h3 { margin-top:0; }
  .work { display:grid; grid-template-columns:minmax(0,260px) 1fr; gap:24px; align-items:center; }
  .work img { width:100%; height:auto; border-radius:8px; }
  @media (max-width:560px){ .work { grid-template-columns:1fr; } }
</style>
