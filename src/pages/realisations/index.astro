---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
const items = (await getCollection('chantiers', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Nos réalisations — Verny Charpente" description="Chantiers de charpente, couverture et zinguerie réalisés par Verny Charpente dans les Landes et au Pays Basque.">
  <main>
    <section>
      <div class="wrap">
        <h1>Nos réalisations</h1>
        <p>Quelques chantiers récents de charpente, de couverture et de zinguerie.</p>
        {items.length === 0 ? <p>Aucune réalisation pour le moment.</p> : (
          <div class="grid">
            {items.map((p) => (
              <PostCard href={`/realisations/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date}
                label={p.data.city} image={p.data.images[0]?.src} imageAlt={p.data.images[0]?.alt} />
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</Base>
<style>
  h1 { margin-top:0; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; margin-top:24px; }
</style>
