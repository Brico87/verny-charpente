---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const items = await getCollection('chantiers', (p) => !p.data.draft);
  return items.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const d = post.data;
---
<Base title={`${d.title} — Verny Charpente`} description={d.description}>
  <main>
    <article class="wrap narrow">
      <p><a href={`${base}/realisations/`}>← Toutes les réalisations</a></p>
      <p class="meta">{d.city && <>{d.city} · </>}<time datetime={d.date.toISOString()}>{fmt.format(d.date)}</time></p>
      <h1>{d.title}</h1>
      {d.services.length > 0 && <ul class="chips">{d.services.map((s) => <li>{s}</li>)}</ul>}
      {d.images[0] && <img class="cover" src={`${base}/${d.images[0].src}`} alt={d.images[0].alt} />}
      <div class="prose"><Content /></div>
      {d.materials.length > 0 && <p class="mat"><strong>Matériaux :</strong> {d.materials.join(', ')}</p>}
      {d.images.length > 1 && (
        <div class="gallery">
          {d.images.slice(1).map((i) => <img src={`${base}/${i.src}`} alt={i.alt} loading="lazy" />)}
        </div>
      )}
      <p class="cta"><a class="btn" href={`${base}/#contact`}>Demander un devis</a></p>
    </article>
  </main>
</Base>
<style>
  article { padding: 48px 20px; }
  .narrow { max-width: 760px; }
  .meta { color:var(--zinc); margin:.5rem 0; }
  h1 { margin:.2rem 0 1rem; font-size:clamp(1.7rem,4vw,2.4rem); }
  .chips { list-style:none; padding:0; display:flex; flex-wrap:wrap; gap:8px; margin:0 0 1rem; }
  .chips li { background:#f1e8da; border-radius:999px; padding:.15rem .8rem; font-size:.85rem; }
  .cover { width:100%; max-height:560px; object-fit:cover; border-radius:10px; margin:0 0 1.5rem; }
  .prose :global(h2) { margin-top:2rem; font-size:1.4rem; }
  .gallery { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; margin-top:1.5rem; }
  .gallery img { width:100%; height:240px; object-fit:cover; border-radius:8px; }
  .cta { margin-top:2.5rem; }
</style>
