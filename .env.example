# Tous les secrets du projet. Copier en .env (jamais commité), remplir, puis : ./setup_secrets_variables.sh
# Une valeur vide est ignorée par le script. Chaque variable indique où elle est envoyée.

# ── Bot Telegram ─────────────────────────────────────────────
# Token donné par @BotFather                                   → Cloudflare Worker + GitHub Actions
TELEGRAM_BOT_TOKEN=
# Chaîne aléatoire au choix (ex. : openssl rand -hex 32)       → Cloudflare Worker (+ setWebhook)
TELEGRAM_WEBHOOK_SECRET=
# Identifiants Telegram autorisés, séparés par des virgules    → Cloudflare Worker
ALLOWED_USER_IDS=
# Conversation qui reçoit les aperçus (privée : votre identifiant) → GitHub Actions
TELEGRAM_CHAT_ID=

# URL publique du Worker, sans slash final (ex. https://verny-telegram.<compte>.workers.dev ; le suffixe /telegram est toléré) → webhook Telegram
# Facultatif : si vide, elle est lue dans la sortie du déploiement.
WORKER_URL=

# ── GitHub ───────────────────────────────────────────────────
# Jeton "fine-grained" limité au dépôt : Contents + Pull requests en lecture/écriture → Cloudflare Worker
GITHUB_TOKEN=

# ── LLM gratuits (repli : Gemini → Groq → Mistral → OpenRouter) → GitHub Actions
GEMINI_API_KEY=
GROQ_API_KEY=
# Facultatifs
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── Avis Google (build du site, deploy.yml) ──────────────────→ GitHub Actions
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
